# ==============================================================================
# Continuous Agent Configuration Template
# Copy this file to .env before starting: cp .env.example .env
# ==============================================================================

# --- [Core Frontier LLM Providers] ---
# Primary OpenAI key (used for baseline FunSearch mutation & Z3 counterexample recovery)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
MODEL_NAME="gpt-4o-mini"

# Optional: Anthropic API Key (Required if routing to Claude Fable 5.1 or Claude Mythos 5.1)
ANTHROPIC_API_KEY=""

# Optional: Custom OpenAI-compatible endpoint (vLLM, SGLang, Muse Spark 1.3)
CUSTOM_MODEL_BASE_URL="http://127.0.0.1:8000/v1"
CUSTOM_MODEL_API_KEY="EMPTY"

# --- [FastAPI Dashboard & Security] ---
# Bearer token / API key protecting REST API endpoints and WebSocket channels
AGENT_API_TOKEN="generate-a-secure-random-token-here"
DASHBOARD_API_KEY="generate-a-secure-random-token-here"
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT=8000
DASHBOARD_BASE_URL="http://127.0.0.1:8000"

# --- [Autonomous GitOps Delivery Pipeline] ---
# GitHub Personal Access Token (Requires 'repo' permissions to create branches and PRs)
GITHUB_TOKEN=""
# Target repository in format "owner/repo" (e.g., "AmithKumar1/algorithm-vault")
GITHUB_REPO=""
GITHUB_BASE_BRANCH="main"

# --- [Nocturnal Alerts & Telegram Reporting] ---
# Optional: Telegram bot token and target chat ID for overnight discovery digests
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- [Evolutionary Island & Sandbox Configuration] ---
NUM_ISLANDS=4
EVALS_PER_ISLAND=25
MAX_CLUSTERS_PER_ISLAND=12
WASM_FUEL_BUDGET=2000000
SANDBOX_TIMEOUT_SEC=4.0
DB_PATH="agent_state.db"

# --- [Scheduler Defaults] ---
# Default nightly cron pattern (02:00 AM UTC every day)
NIGHTLY_DISCOVERY_CRON="0 2 * * *"
AUTO_PR_FITNESS_THRESHOLD=0.88

# --- [Cognitive Memory & Compaction] ---
MEMORY_COMPACTION_THRESHOLD=12
MEMORY_COMPACTION_MODEL="gpt-4o-mini"
