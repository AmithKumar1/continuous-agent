# ==============================================================================
# Autonomous Continuous Discovery Agent — Environment Template
# ==============================================================================

# LLM Providers
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-api-key
CUSTOM_MODEL_BASE_URL=

# Dashboard Authentication & Access
DASHBOARD_API_KEY=change-me-in-production

# Agent Core Engine
AGENT_MODEL_NAME=gpt-4o-mini
HEARTBEAT_INTERVAL_SECONDS=60
MAX_CONSECUTIVE_FAILURES=5
MAX_CONCURRENT_TOOL_CALLS=5
AGENT_DB_PATH=agent_state.db

# GitHub GitOps Automation (Automated PR Creation)
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO=AmithKumar1/continuous-agent
GITHUB_BASE_BRANCH=main

# Notifications (Telegram Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security Reconnaissance & Audit Target Scope
SECURITY_SCAN_ALLOWED_HOSTS=localhost,127.0.0.1,testphp.vulnweb.com
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=

# Sandboxing & Toolchain
WASM_FUEL_BUDGET=50000000
GVISOR_TIMEOUT_SECONDS=5.0
LEAN_BIN_PATH=lean
